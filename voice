#!/usr/bin/env zsh

# voice - A simple script to record voice, transcribe it with Whisper, and save to a file
# Usage: voice
# Press Enter to stop recording

# Check for dependencies
check_dependencies() {
  local missing_deps=()
  
  # Check for sox (for recording)
  if ! command -v rec &> /dev/null; then
    missing_deps+=("sox (for audio recording)")
  fi
  
  # Check for ffmpeg (required by whisper)
  if ! command -v ffmpeg &> /dev/null; then
    missing_deps+=("ffmpeg (required for audio processing)")
  fi
  
  # Check for whisper
  if ! command -v whisper &> /dev/null; then
    if [[ -x "$HOME/.asdf/installs/python/3.9.9/bin/whisper" ]]; then
      # Add specific whisper path to PATH
      export PATH="$HOME/.asdf/installs/python/3.9.9/bin:$PATH"
    else
      missing_deps+=("whisper (OpenAI's transcription tool)")
    fi
  fi
  
  # Check for pbcopy (macOS clipboard)
  if ! command -v pbcopy &> /dev/null; then
    missing_deps+=("pbcopy (for clipboard operations)")
  fi
  
  # If any dependencies are missing, inform the user and exit
  if (( ${#missing_deps[@]} > 0 )); then
    echo "Error: The following dependencies are missing:"
    for dep in "${missing_deps[@]}"; do
      echo "  - $dep"
    done
    echo ""
    echo "Please install the missing dependencies and try again."
    echo "For sox: brew install sox"
    echo "For ffmpeg: brew install ffmpeg"
    echo "For whisper: pip install -U openai-whisper"
    exit 1
  fi
}

# Ensure the voicememos directory and tmp subdirectory exist
ensure_voicememos_dir() {
  local voicememos_dir="$HOME/voicememos"
  local tmp_dir="$voicememos_dir/tmp"
  
  if [[ ! -d "$voicememos_dir" ]]; then
    echo "Creating voicememos directory at $voicememos_dir"
    mkdir -p "$voicememos_dir" || {
      echo "Error: Failed to create directory $voicememos_dir"
      exit 1
    }
  fi
  
  if [[ ! -d "$tmp_dir" ]]; then
    echo "Creating temporary directory at $tmp_dir"
    mkdir -p "$tmp_dir" || {
      echo "Error: Failed to create directory $tmp_dir"
      exit 1
    }
  fi
}

# Record audio until Enter is pressed
record_audio() {
  local audio_file="$1"
  
  echo "Recording... Press Enter to stop."
  rec -r 48000 -c 1 "$audio_file" trim 0 silence 1 0.1 1% &
  local rec_pid=$!
  
  # Wait for Enter key
  read -s
  
  # Stop recording
  kill $rec_pid 2>/dev/null
  wait $rec_pid 2>/dev/null
  
  echo "Recording stopped."
}

# Transcribe audio with whisper
transcribe_audio() {
  local audio_file="$1"
  local transcript_file="$2"
  
  echo "Transcribing audio with Whisper..."
  # Capture whisper's output directly
  local whisper_output=$(whisper "$audio_file" --model base 2>&1)
  local whisper_status=$?
  
  # Check if whisper ran successfully
  if [[ $whisper_status -ne 0 ]]; then
    echo "Error: Whisper command failed with status $whisper_status" >&2
    exit 1
  fi
  
  # Extract just the transcribed text, removing timestamps and other info
  # Look for lines that match the timestamp pattern [00:00.000 --> 00:00.000] and extract the text
  echo "Full whisper output:"
  echo "$whisper_output"
  local transcription=$(echo "$whisper_output" | grep -E '^\[.*-->.*\]' | sed -E 's/\[.*-->.*\](.*)/\1/g' | tr -d '\n')
  
  # Trim leading/trailing whitespace
  transcription=$(echo "$transcription" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
  
  if [[ -n "$transcription" ]]; then
    # Write the extracted transcription to the output file
    echo "$transcription" > "$transcript_file"
  else
    # If we couldn't extract any text, save the full output for debugging
    echo "Warning: Could not extract transcription text" >&2
    echo "$whisper_output" > "$transcript_file"
    echo "Full whisper output saved to $transcript_file for debugging" >&2
  fi
}

# Save content to clipboard
copy_to_clipboard() {
  local content="$1"
  
  echo "$content" | pbcopy
  echo "Content copied to clipboard"
}

# Clean up temporary files
cleanup() {
  local audio_file="$1"
  
  # Remove temporary files
  [[ -f "$audio_file" ]] && rm "$audio_file"
  
  # Optional: Clean up old temp files (older than 1 day)
  find "$HOME/voicememos/tmp" -type f -mtime +1 -delete 2>/dev/null || true
}

# Main function
main() {
  # Check dependencies
  check_dependencies
  
  # Ensure voicememos directory exists
  ensure_voicememos_dir
  
  # Create temp file for audio in the voicememos/tmp directory
  local audio_file="$HOME/voicememos/tmp/audio_$(date +"%Y%m%d_%H%M%S").wav"
  
  # Record audio
  record_audio "$audio_file"
  
  # Create timestamp for filename
  local timestamp=$(date +"%Y%m%d_%H%M%S")
  local transcript_file="$HOME/voicememos/memo_${timestamp}.txt"
  
  # Transcribe audio
  transcribe_audio "$audio_file" "$transcript_file"
  
  # Check if transcription was successful
  if [[ -f "$transcript_file" ]]; then
    # Get the content
    local content=$(cat "$transcript_file")
    
    # Show the content
    echo "Transcription:"
    echo "-------------------------------"
    echo "$content"
    echo "-------------------------------"
    
    # Copy to clipboard
    copy_to_clipboard "$content"
    
    echo "Saved voice memo to $transcript_file"
  else
    echo "Transcription failed."
    exit 1
  fi
  
  # Clean up
  cleanup "$audio_file"
  
  echo "Voice memo processed successfully!"
}

# Run the main function
main "$@"

