#!/usr/bin/env zsh

# voice - A simple script to record voice, transcribe it with Whisper, and save to a file
# Usage: voice [--tone <tone_type>]
#   --tone: Optional. Reformat the transcription with the specified tone.
#           Available tones: business_casual, formal, email, slack, direct_message, social_media, article
# Press Enter to stop recording

# Check for dependencies
check_dependencies() {
  local missing_deps=()

  # Check for sox (for recording)
  if ! command -v rec &> /dev/null; then
    missing_deps+=("sox (for audio recording)")
  fi

  # Check for ffmpeg (required by whisper)
  if ! command -v ffmpeg &> /dev/null; then
    missing_deps+=("ffmpeg (required for audio processing)")
  fi

  # Check for whisper
  if ! command -v whisper &> /dev/null; then
    if [[ -x "$HOME/.asdf/installs/python/3.9.9/bin/whisper" ]]; then
      # Add specific whisper path to PATH
      export PATH="$HOME/.asdf/installs/python/3.9.9/bin:$PATH"
    else
      missing_deps+=("whisper (OpenAI's transcription tool)")
    fi
  fi

  # Check for pbcopy (macOS clipboard)
  if ! command -v pbcopy &> /dev/null; then
    missing_deps+=("pbcopy (for clipboard operations)")
  fi
  
  # Check for curl (for OpenAI API calls)
  if ! command -v curl &> /dev/null; then
    missing_deps+=("curl (for API calls)")
  fi
  
  # Check for jq (for JSON parsing)
  if ! command -v jq &> /dev/null; then
    missing_deps+=("jq (for JSON parsing)")
  fi

  # If any dependencies are missing, inform the user and exit
  if (( ${#missing_deps[@]} > 0 )); then
    echo "Error: The following dependencies are missing:"
    for dep in "${missing_deps[@]}"; do
      echo "  - $dep"
    done
    echo ""
    echo "Please install the missing dependencies and try again."
    echo "For sox: brew install sox"
    echo "For ffmpeg: brew install ffmpeg"
    echo "For whisper: pip install -U openai-whisper"
    exit 1
  fi
}

# Ensure the voicememos directory and subdirectories exist
ensure_voicememos_dir() {
  local voicememos_dir="$HOME/voicememos"
  local tmp_dir="$voicememos_dir/tmp"
  local logs_dir="$voicememos_dir/logs"
  
  if [[ ! -d "$voicememos_dir" ]]; then
    echo "Creating voicememos directory at $voicememos_dir"
    mkdir -p "$voicememos_dir" || {
      echo "Error: Failed to create directory $voicememos_dir"
      exit 1
    }
  fi
  
  if [[ ! -d "$tmp_dir" ]]; then
    echo "Creating temporary directory at $tmp_dir"
    mkdir -p "$tmp_dir" || {
      echo "Error: Failed to create directory $tmp_dir"
      exit 1
    }
  fi
  
  if [[ ! -d "$logs_dir" ]]; then
    echo "Creating logs directory at $logs_dir"
    mkdir -p "$logs_dir" || {
      echo "Error: Failed to create directory $logs_dir"
      exit 1
    }
  fi
}

# Record audio until Enter is pressed
record_audio() {
  local audio_file="$1"

  local timestamp=$(date +"%Y%m%d_%H%M%S")
  local log_file="$HOME/voicememos/logs/rec_${timestamp}.log"
  
  echo "Recording... Press Enter to stop."
  rec -r 48000 -c 1 "$audio_file" trim 0 silence 1 0.1 1% > "$log_file" 2>&1 &
  local rec_pid=$!

  # Wait for Enter key
  read -s

  # Stop recording
  kill $rec_pid 2>/dev/null
  wait $rec_pid 2>/dev/null

  echo "Recording stopped."
}

# Transcribe audio with whisper
transcribe_audio() {
  local audio_file="$1"
  local transcript_file="$2"

  echo "Transcribing audio with Whisper..."
  # Get timestamp for log file
  local timestamp=$(date +"%Y%m%d_%H%M%S")
  local whisper_log="$HOME/voicememos/logs/whisper_${timestamp}.log"
  
  # Capture whisper's output directly - use --output_dir and --output_format to control files
  local whisper_output=$(whisper "$audio_file" --model base --output_dir "$HOME/voicememos/tmp" --output_format txt 2> "$whisper_log")
  local whisper_status=$?

  # Check if whisper ran successfully
  if [[ $whisper_status -ne 0 ]]; then
    echo "Error: Whisper command failed with status $whisper_status" >&2
    exit 1
  fi

  # Extract just the transcribed text, removing timestamps and other info
  # Look for lines that match the timestamp pattern [00:00.000 --> 00:00.000] and extract the text

  # Process each line with timestamps and combine them with proper spacing
  local transcription=$(echo "$whisper_output" | grep -E '^\[.*-->.*\]' | sed -E 's/\[.*-->.*\](.*)/\1/g' | awk '{$1=$1};1' | paste -sd " " - | tr -d '\n')

  # Trim leading/trailing whitespace
  transcription=$(echo "$transcription" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')

  if [[ -n "$transcription" ]]; then
    # Write the extracted transcription to the output file without adding an extra newline
    printf "%s" "$transcription" > "$transcript_file"
  else
    # If we couldn't extract any text, save the full output for debugging
    echo "Warning: Could not extract transcription text" >&2
    echo "$whisper_output" > "$transcript_file"
    echo "Full whisper output saved to $transcript_file for debugging" >&2
  fi
}

# Apply tone transformation using OpenAI API
apply_tone() {
  local content="$1"
  local tone="$2"
  local timestamp=$(date +"%Y%m%d_%H%M%S")
  local log_file="$HOME/voicememos/logs/openai_${timestamp}.log"
  
  # Check if OPENAI_API_KEY is set
  if [[ -z "$OPENAI_API_KEY" ]]; then
    echo "Error: OPENAI_API_KEY environment variable is not set" >&2
    echo "Please set it with: export OPENAI_API_KEY='your-api-key'" >&2
    return 1
  fi
  
  # Create the system prompt based on the tone
  core_prompt = "You are a dictation assistant for Mike Wheeler, a CTO of G2.com. Mike is a busy executive who is still an individual contributor, and actively coding on a daily basis. He is a web developer first, and a CTO second. He is a product engineer that focuses on highly integrated teams building early business solutions. You will be used to take dictation for voice messages, emails, articles and announcements, as well as technical specifications and note keeping."
  local system_prompt
  case "$tone" in
    business_casual)
      system_prompt="You are a professional assistant that reformats text into a business casual tone. Keep the content intact but make it appropriate for professional settings while maintaining a conversational feel."
      ;;
    formal)
      system_prompt="You are a professional assistant that reformats text into a formal tone. Keep the content intact but make it appropriate for formal business or academic settings."
      ;;
    email)
      system_prompt="You are a professional assistant that reformats text into a proper email format. Keep the content intact but structure it as a professional email with greeting and signature."
      ;;
    slack)
      system_prompt="You are a professional assistant that reformats text into a Slack message style. Keep the content intact but make it concise and appropriate for team communication on Slack."
      ;;
    direct_message)
      system_prompt="You are a professional assistant that reformats text into a direct message style. Keep the content intact but make it conversational and appropriate for one-on-one messaging."
      ;;
    social_media)
      system_prompt="You are a professional assistant that reformats text into a social media post style. Keep the content intact but make it engaging and appropriate for social media platforms."
      ;;
    article)
      system_prompt="You are a professional assistant that reformats text into an article style. Keep the content intact but structure it with proper paragraphs, transitions, and a more formal writing style."
      ;;
    *)
      echo "Unknown tone: $tone" >&2
      echo "Available tones: business_casual, formal, email, slack, direct_message, social_media, article" >&2
      return 1
      ;;
  esac
  
  # Create the API request payload
  local payload=$(cat <<EOF
{
  "model": "gpt-4o",
  "messages": [
    {
      "role": "system",
      "content": "$system_prompt"
    },
    {
      "role": "user",
      "content": "Please reformat the following text into a $tone tone, preserving all the key information: $content"
    }
  ],
  "temperature": 0.7
}
EOF
)
  
  # Make the API request
  local response=$(curl -s -X POST "https://api.openai.com/v1/chat/completions" \
    -H "Content-Type: application/json" \
    -H "Authorization: Bearer $OPENAI_API_KEY" \
    -d "$payload" 2> "$log_file")
  
  # Check if the API call was successful
  if [[ $? -ne 0 ]]; then
    echo "Error: Failed to call OpenAI API" >&2
    echo "Check log file for details: $log_file" >&2
    return 1
  fi
  
  # Log the full response for debugging
  echo "Full API Response:" >> "$log_file"
  echo "$response" >> "$log_file"
  
  # Check if the response contains an error
  if echo "$response" | grep -q "error"; then
    echo "Error from OpenAI API:" >&2
    echo "$response" | jq -r '.error.message // "Unknown error"' >&2
    return 1
  fi
  
  # Extract the content from the response
  local formatted_content=$(echo "$response" | jq -r '.choices[0].message.content' 2>> "$log_file")
  local jq_status=$?
  
  # Check if jq extraction was successful
  if [[ $jq_status -ne 0 || -z "$formatted_content" ]]; then
    echo "Error: Failed to parse OpenAI API response" >&2
    echo "Response structure may be unexpected" >&2
    echo "Full response saved to: $log_file" >&2
    return 1
  fi
  
  echo "$formatted_content"
}

# Save content to clipboard
copy_to_clipboard() {
  local content="$1"

  printf "%s" "$content" | pbcopy
  echo "Content copied to clipboard"
}

# Clean up temporary files
cleanup() {
  local audio_file="$1"

  # Remove temporary files
  [[ -f "$audio_file" ]] && rm "$audio_file"

  # Clean up whisper output files
  local base_name=$(basename "$audio_file" .wav)
  [[ -f "$HOME/voicememos/tmp/$base_name.txt" ]] && rm "$HOME/voicememos/tmp/$base_name.txt"

  # Optional: Clean up old temp files and logs (older than 1 day)
  find "$HOME/voicememos/tmp" -type f -mtime +1 -delete 2>/dev/null || true
  find "$HOME/voicememos/logs" -type f -mtime +1 -delete 2>/dev/null || true
}

# Parse command line arguments
parse_args() {
  local tone=""
  
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --tone)
        if [[ -n "$2" && "$2" != --* ]]; then
          tone="$2"
          shift 2
        else
          echo "Error: --tone requires an argument" >&2
          echo "Available tones: business_casual, formal, email, slack, direct_message, social_media, article" >&2
          exit 1
        fi
        ;;
      *)
        echo "Unknown option: $1" >&2
        echo "Usage: voice [--tone <tone_type>]" >&2
        echo "Available tones: business_casual, formal, email, slack, direct_message, social_media, article" >&2
        exit 1
        ;;
    esac
  done
  
  echo "$tone"
}

# Main function
main() {
  # Parse command line arguments
  local tone=$(parse_args "$@")
  
  # Check dependencies
  check_dependencies

  # Ensure voicememos directory exists
  ensure_voicememos_dir

  # Create temp file for audio in the voicememos/tmp directory
  local audio_file="$HOME/voicememos/tmp/audio_$(date +"%Y%m%d_%H%M%S").wav"

  # Record audio
  record_audio "$audio_file"

  # Create timestamp for filename
  local timestamp=$(date +"%Y%m%d_%H%M%S")
  local transcript_file="$HOME/voicememos/memo_${timestamp}.txt"

  # Transcribe audio
  transcribe_audio "$audio_file" "$transcript_file"

  # Check if transcription was successful
  if [[ -f "$transcript_file" ]]; then
    # Get the content
    local content=$(cat "$transcript_file")
    local final_content="$content"
    
    # Apply tone transformation if requested
    if [[ -n "$tone" ]]; then
      local formatted_content=$(apply_tone "$content" "$tone")
      
      local tone_status=$?
      if [[ $tone_status -eq 0 && -n "$formatted_content" ]]; then
        # Save the formatted content to a new file
        local formatted_file="$HOME/voicememos/memo_${timestamp}_${tone}.txt"
        printf "%s" "$formatted_content" > "$formatted_file"
        final_content="$formatted_content"
        
        echo "Original Transcription:"
        echo "-------------------------------"
        echo "$content"
        echo "-------------------------------"
        
        echo "Formatted with $tone tone:"
        echo "-------------------------------"
        echo "$formatted_content"
        echo "-------------------------------"
        
        echo "Saved formatted memo to $formatted_file"
        
        # Copy the formatted content to clipboard
        copy_to_clipboard "$formatted_content"
      else
        echo "Warning: Tone formatting failed (status: $tone_status), using original transcription" >&2
        echo "Check logs in $HOME/voicememos/logs/ for details" >&2
        
        echo "Transcription:"
        echo "-------------------------------"
        echo "$content"
        echo "-------------------------------"
      fi
    else
      # Show the content
      echo "Transcription:"
      echo "-------------------------------"
      echo "$content"
      echo "-------------------------------"
    fi

    # Copy to clipboard only if we haven't already done so
    if [[ -z "$tone" || ($tone_status -ne 0 || -z "$formatted_content") ]]; then
      copy_to_clipboard "$final_content"
    fi

    echo "Saved voice memo to $transcript_file"
  else
    echo "Transcription failed."
    exit 1
  fi

  # Clean up
  cleanup "$audio_file"

  echo "Voice memo processed successfully!"
}

# Run the main function
main "$@"

